<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.epsilon</groupId>
    <artifactId>epsilon-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>epsilon-reviewer</artifactId>
  <name>Epsilon AI Reviewer server</name>
  <properties>
    <epsilon.mainClass>com.epsilon.reviewer.Main</epsilon.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Nano・Major・規則の打ち手の ModelFamily。Reviewer は classic を import せず、実行時に ServiceLoader で見つける。 -->
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-classic</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- PRISM の ModelFamily と、四人打ち・三人打ちの入力の形式。classic と同じく実行時に ServiceLoader で見つける。 -->
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-prism</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-prism-4p</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-prism-3p</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- 試験の牌譜をエンジンで打つ道具（RecordedGames・Scenes）と、小さな乱数の checkpoint を書く道具。 -->
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-mahjong</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.epsilon</groupId>
      <artifactId>epsilon-classic</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>epsilon-reviewer</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!--
      デスクトップの jar（target/epsilon-reviewer-1.0-SNAPSHOT-desktop.jar）。Windows x64 のアプリが読まない他の OS のネイティブ
      （zstd-jni・JNA の win amd64 以外、jnilib）を除く。
    -->
    <profile>
      <id>desktop</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <executions>
              <execution>
                <id>desktop</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>desktop</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>${epsilon.mainClass}</mainClass>
                      <manifestEntries>
                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                      </manifestEntries>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                      <addHeader>false</addHeader>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                      <resource>META-INF/LICENSE</resource>
                      <file>${project.build.outputDirectory}/META-INF/LICENSE</file>
                    </transformer>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/LICENSE</exclude>
                        <exclude>jnilib/**</exclude>
                      </excludes>
                    </filter>
                    <filter>
                      <artifact>com.github.luben:zstd-jni</artifact>
                      <excludes>
                        <exclude>aix/**</exclude>
                        <exclude>darwin/**</exclude>
                        <exclude>freebsd/**</exclude>
                        <exclude>linux/**</exclude>
                        <exclude>win/aarch64/**</exclude>
                        <exclude>win/x86/**</exclude>
                      </excludes>
                    </filter>
                    <filter>
                      <artifact>net.java.dev.jna:jna</artifact>
                      <excludes>
                        <exclude>com/sun/jna/*/libjnidispatch.*</exclude>
                        <exclude>com/sun/jna/win32-x86/**</exclude>
                        <exclude>com/sun/jna/win32-aarch64/**</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
