<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.epsilon</groupId>
    <artifactId>epsilon-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>epsilon-prism-hip</artifactId>
  <name>Epsilon Prism HIP</name>
  <description>PRISM の HIP の実行系（網を知らない薄い JNI と自前のカーネル）</description>
  <properties>
    <!-- ROCm の根（HIP の実行系とヘッダ。DJL の libtorch 2.11.0+rocm7.2 と同じ 7.2 系）。 -->
    <prism.hip.rocm>/opt/rocm-7.2.2</prism.hip.rocm>
    <!-- 翻訳は ROCm 7.2.2 の clang で行う。機器の側の結合（amdgcn-link）だけは、7.2.2 の lld が Ubuntu 26.04 で libxml2.so.2 を
         欠いて起動しないため、同じ機械の ROCm 10 core の lld を -B で借りる。 -->
    <prism.hip.lld>/opt/rocm-7.2.2/llvm/bin</prism.hip.lld>
    <prism.hip.arch>gfx1100</prism.hip.arch>
    <prism.hip.jobs>8</prism.hip.jobs>
    <prism.hip.build>${project.build.directory}/native-build</prism.hip.build>
  </properties>
  <profiles>
    <!-- native の組み立て。サーバ（ROCm と cmake がある所）で -Pnative-hip のときだけ。既定の組み立ては Java の部分だけで、
         jar に .so が入らないので HipLibrary.load() は英語の例外で止まる。 -->
    <profile>
      <id>native-hip</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <!-- libprism_hip.so（通常）と libprism_hip_check.so（-DPRISM_HIP_CHECK）を classes/native/linux-x86_64 に作る。 -->
                <id>native-hip</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <exec executable="cmake" failonerror="true">
                      <arg value="-S" />
                      <arg value="${project.basedir}/src/main/native" />
                      <arg value="-B" />
                      <arg value="${prism.hip.build}" />
                      <arg value="-DCMAKE_BUILD_TYPE=Release" />
                      <arg value="-DCMAKE_HIP_COMPILER=${prism.hip.rocm}/lib/llvm/bin/clang++" />
                      <arg value="-DCMAKE_HIP_FLAGS=-B${prism.hip.lld}" />
                      <arg value="-DCMAKE_HIP_ARCHITECTURES=${prism.hip.arch}" />
                      <arg value="-DCMAKE_PREFIX_PATH=${prism.hip.rocm}" />
                      <arg value="-DPRISM_JAVA_HOME=${java.home}" />
                      <arg value="-DPRISM_OUTPUT_DIR=${project.build.outputDirectory}/native/linux-x86_64" />
                      <arg value="-DPRISM_TORCH_VERSION=${pytorch.native.version}" />
                      <arg value="-DPRISM_TORCH_FLAVOR=${pytorch.linux.flavor}" />
                    </exec>
                    <exec executable="cmake" failonerror="true">
                      <arg value="--build" />
                      <arg value="${prism.hip.build}" />
                      <arg value="--parallel" />
                      <arg value="${prism.hip.jobs}" />
                    </exec>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
