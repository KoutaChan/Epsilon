{
  "name": "epsilon-reviewer",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "server": "java -jar backend/target/epsilon-reviewer-1.0-SNAPSHOT-all.jar --host 127.0.0.1 --port 8080 --origin http://127.0.0.1:8080 --models models.local.json --data-dir .data --web-dir web/dist",
    "build": "npm run check:language && npm run build --workspace web && npm run build --workspace desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop": "npm run start --workspace desktop",
    "desktop:pack": "npm run build && npm run pack --workspace desktop",
    "test:desktop": "npm run test --workspace desktop",
    "vendor:tiles": "node tools/vendor-tiles.mjs",
    "check:language": "node tools/check-language.mjs",
    "test": "npm run check:language && npm run test:web && npm run test:desktop",
    "test:web": "node --test web/tests/*.test.mjs"
  }
}
